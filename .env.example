# Brand 1: Ritika Jaiswal Fashion (www.ritikajaiswalfashion.com)
# Primary: +91923759949 (Note: If your WhatsApp number has 10 digits, set it here)
RITIKA_WHATSAPP_NUMBER=91923759949
RITIKA_PHONE_NUMBER_ID=your_ritika_phone_number_id

# Brand 2: PS DigiLabs (www.psdigilabs.in)
# Primary: +916289482083
PS_WHATSAPP_NUMBER=916289482083
